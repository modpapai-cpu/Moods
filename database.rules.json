{
  "rules": {
    "moods": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'modpapai@gmail.com'"
    },
    "users": {
      "$uid": {
        "library": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || data.child('members').child(auth.uid).val() === true)",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('createdBy').exists()"
          }
        }
      }
    },
    "presence": {
      "connections": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
